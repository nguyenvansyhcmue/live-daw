+bool VibeAutotuneEditor::isNoteInSelectedVoiceRange (int midiNote) const noexcept
+{
+    // Display range only; audio tracking limits remain wholly DSP-owned.
+    static constexpr std::array<std::pair<int, int>, 4> ranges {{
+        { 52, 84 }, // Soprano: E3–C6
+        { 55, 77 }, // Alto:    G3–F5
+        { 48, 72 }, // Tenor:   C3–C5
+        { 40, 64 }  // Low:     E2–E4
+    }};
+    const auto* parameter = processor.parameters.getRawParameterValue ("inputType");
+    const auto voice = parameter != nullptr ? juce::jlimit (0, 3, juce::roundToInt (parameter->load (std::memory_order_relaxed))) : 1;
+    const auto [lowest, highest] = ranges[(size_t) voice];
+    return midiNote >= lowest && midiNote <= highest;
+}

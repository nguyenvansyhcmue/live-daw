diff --git a/Source/Plugins/LiveTuneConfidenceGate.h b/Source/Plugins/LiveTuneConfidenceGate.h
new file mode 100644
--- /dev/null
+++ b/Source/Plugins/LiveTuneConfidenceGate.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+// A small, allocation-free gate between F0 analysis and the live renderer.
+// It deliberately does not decide pitch targets or change renderer timing.
+// The lower hold threshold and short hangover stop vibrato/consonants from
+// repeatedly opening and closing the wet path during a sustained phrase.
+class LiveTuneConfidenceGate
+{
+public:
+    static constexpr float enterConfidence = 0.52f;
+    static constexpr float holdConfidence = 0.42f;
+    static constexpr double dropoutHoldSeconds = 0.035;
+
+    void reset() noexcept
+    {
+        open = false;
+        remainingHoldSamples = 0;
+    }
+
+    bool advance(bool trackerVoiced, float confidence, int callbackSamples, double sampleRate) noexcept
+    {
+        const auto finiteConfidence = std::isfinite(confidence);
+        const auto threshold = open ? holdConfidence : enterConfidence;
+        const auto confident = trackerVoiced && finiteConfidence && confidence >= threshold;
+
+        if (confident)
+        {
+            open = true;
+            remainingHoldSamples = std::max(1, static_cast<int>(std::ceil(
+                std::max(1.0, sampleRate) * dropoutHoldSeconds)));
+        }
+        else if (open && remainingHoldSamples > 0)
+        {
+            remainingHoldSamples = std::max(0, remainingHoldSamples - std::max(1, callbackSamples));
+            if (remainingHoldSamples == 0)
+                open = false;
+        }
+        else
+        {
+            open = false;
+        }
+
+        return open;
+    }
+
+    bool isOpen() const noexcept { return open; }
+
+private:
+    bool open = false;
+    int remainingHoldSamples = 0;
+};
diff --git a/Tests/LiveTuneConfidenceGateTest.cpp b/Tests/LiveTuneConfidenceGateTest.cpp
new file mode 100644
--- /dev/null
+++ b/Tests/LiveTuneConfidenceGateTest.cpp
@@ -0,0 +1,54 @@
+#include "Plugins/LiveTuneConfidenceGate.h"
+
+#include <iostream>
+#include <limits>
+
+namespace
+{
+bool survivesDropout(int callbackSamples)
+{
+    LiveTuneConfidenceGate gate;
+    if (gate.advance(true, 0.51f, callbackSamples, 48000.0)) return false;
+    if (! gate.advance(true, 0.52f, callbackSamples, 48000.0)) return false;
+    if (! gate.advance(true, 0.43f, callbackSamples, 48000.0)) return false;
+
+    int elapsedSamples = 0;
+    while (elapsedSamples + callbackSamples < 1680)
+    {
+        if (! gate.advance(false, 0.0f, callbackSamples, 48000.0)) return false;
+        elapsedSamples += callbackSamples;
+    }
+    return ! gate.advance(false, 0.0f, callbackSamples, 48000.0);
+}
+}
+
+int main()
+{
+    for (const auto callbackSamples : { 32, 64, 128 })
+        if (! survivesDropout(callbackSamples))
+        {
+            std::cerr << "Confidence gate hysteresis failed at " << callbackSamples << " samples\n";
+            return 1;
+        }
+
+    LiveTuneConfidenceGate gate;
+    if (! gate.advance(true, 0.80f, 64, 48000.0))
+    {
+        std::cerr << "Confidence gate did not open for stable voice\n";
+        return 1;
+    }
+    if (! gate.advance(true, std::numeric_limits<float>::quiet_NaN(), 64, 48000.0))
+    {
+        std::cerr << "Confidence gate dropped too early for one invalid tracker frame\n";
+        return 1;
+    }
+    gate.reset();
+    if (gate.isOpen())
+    {
+        std::cerr << "Confidence gate reset failed\n";
+        return 1;
+    }
+
+    std::cout << "live_confidence_gate | 32=pass 64=pass 128=pass hysteresis=pass reset=pass\n";
+    return 0;
+}

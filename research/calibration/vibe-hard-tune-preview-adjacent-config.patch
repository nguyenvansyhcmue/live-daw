+        const auto previewIsAdjacent = currentTargetNote >= 0 && trajectoryPreviewNote >= 0
+                                    && std::abs (trajectoryPreviewNote - currentTargetNote) == 1;
+        const auto canUseHardTunePreview = enableHardTuneTrajectoryPreview && previewIsAdjacent;
         const auto hardTuneCandidate = canUseHardTunePreview ? trajectoryPreviewNote

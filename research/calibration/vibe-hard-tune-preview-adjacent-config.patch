diff --git a/VibeAutotune/CorrectionTrajectory.h b/VibeAutotune/CorrectionTrajectory.h
--- a/VibeAutotune/CorrectionTrajectory.h
+++ b/VibeAutotune/CorrectionTrajectory.h
@@ -721,5 +721,10 @@ public:
         // target until it has a separately validated renderer use.
         constexpr bool enableHardTuneTrajectoryPreview = VIBE_HARD_TUNE_TRAJECTORY_PREVIEW != 0;
-        const auto canUseHardTunePreview = enableHardTuneTrajectoryPreview && trajectoryPreviewNote >= 0;
+        // A future target is useful only for a single adjacent legato step.

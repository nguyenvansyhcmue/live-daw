+void VibeAutotuneEditor::drawRuleMarker (juce::Graphics& g, juce::Rectangle<float> b, NoteRule rule) const
+{
+    b = b.reduced (1.0f);
+    const auto colour = rule == NoteRule::Legal         ? brass
+                      : rule == NoteRule::IllegalNearest ? juce::Colour (0xffdc655e)
+                      : rule == NoteRule::IllegalUp      ? ice
+                      : rule == NoteRule::IllegalDown    ? juce::Colour (0xffb68ae3)
+                                                           : muted;
+    const auto glyph = rule == NoteRule::Legal ? juce::String ("•")
+                                                : juce::String (noteRuleGlyph (rule));
+    g.setColour (juce::Colours::black.withAlpha (.52f));
+    g.fillRoundedRectangle (b, 2.5f);
+    g.setColour (colour.withAlpha (.76f));
+    g.drawRoundedRectangle (b, 2.5f, .8f);
+    g.setColour (colour);
+    g.setFont (juce::FontOptions (juce::jmax (10.0f, b.getHeight() * .80f), juce::Font::bold));
+    g.drawText (glyph, b.toNearestInt(), juce::Justification::centred);
+}

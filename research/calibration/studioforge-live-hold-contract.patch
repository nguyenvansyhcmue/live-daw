diff --git a/Source/Plugins/LiveTuneConfidenceGate.h b/Source/Plugins/LiveTuneConfidenceGate.h
index 62f5a77..439b632 100644
--- a/Source/Plugins/LiveTuneConfidenceGate.h
+++ b/Source/Plugins/LiveTuneConfidenceGate.h
@@ -12,11 +12,14 @@ class LiveTuneConfidenceGate
 public:
     static constexpr float enterConfidence = 0.52f;
     static constexpr float holdConfidence = 0.42f;
-    static constexpr double dropoutHoldSeconds = 0.035;
+    // This is a continuity window, not a second detector. It covers normal
+    // consonants and note transitions before wet release begins.
+    static constexpr double dropoutHoldSeconds = 0.075;
 
     void reset() noexcept
     {
         open = false;
+        holding = false;
         remainingHoldSamples = 0;
     }
 
@@ -29,26 +32,34 @@ public:
         if (confident)
         {
             open = true;
+            holding = false;
             remainingHoldSamples = std::max(1, static_cast<int>(std::ceil(
                 std::max(1.0, sampleRate) * dropoutHoldSeconds)));
         }
         else if (open && remainingHoldSamples > 0)
         {
+            holding = true;
             remainingHoldSamples = std::max(0, remainingHoldSamples - std::max(1, callbackSamples));
             if (remainingHoldSamples == 0)
+            {
                 open = false;
+                holding = false;
+            }
         }
         else
         {
             open = false;
+            holding = false;
         }
 
         return open;
     }
 
     bool isOpen() const noexcept { return open; }
+    bool isHolding() const noexcept { return holding; }
 
 private:
     bool open = false;
+    bool holding = false;
     int remainingHoldSamples = 0;
 };

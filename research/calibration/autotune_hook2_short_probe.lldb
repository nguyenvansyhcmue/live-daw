# OFFLINE ONLY. Stop at the first Artist DSP call; do not render the matrix.
command script import /Users/hiimdrdey/autotune/autotune_hook2_state_trace.py
script autotune_hook2_state_trace.initialize(lldb.debugger)
target modules add '/Library/Audio/Plug-Ins/Components/Auto-Tune Artist.component/Contents/MacOS/Auto-Tune Artist'
breakpoint set --name 'AutoTunePluginAudioProcessor::parameterChanged' --shlib 'Auto-Tune Artist'
breakpoint command add -F autotune_hook2_state_trace.parameter_changed 1
breakpoint set --name 'ATLiveDSP::AT_DSPObject::process' --shlib 'Auto-Tune Artist'
breakpoint command add -F autotune_hook2_state_trace.probe_at_process 2
breakpoint set --name 'ATLiveDSP::DT_DSPObject::process' --shlib 'Auto-Tune Artist'
breakpoint command add -F autotune_hook2_state_trace.probe_dt_process 3
breakpoint set --name 'JuceAU::SetParameter' --shlib 'Auto-Tune Artist'
breakpoint command add -F autotune_hook2_state_trace.au_set_parameter 4
run
process kill
